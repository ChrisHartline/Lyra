GROK_API_KEY=
GROK_BASE_URL=
LYRA_MODEL=
LINEAR_API_KEY=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=

# Notion (human dashboard — FR-N1/N2)
# Accept either name; Lyra reads NOTION_TOKEN first, then NOTION_API_TOKEN.
NOTION_TOKEN=
# Full-page DB / working space from Notion share link (hyphenated UUID)
LYRA_NOTION_PAGE_ID=3a90f9f9-7567-80f2-835e-c665e64927e0
LYRA_NOTION_DATABASE_ID=3a90f9f9-7567-80f2-835e-c665e64927e0
LYRA_NOTION_VIEW_ID=a610f9f9-7567-83e4-a862-08b328e8e7f2

# Optional: override DB defaults (docker-compose maps host 55432 → container 5432)
# LYRA_DB_HOST=127.0.0.1
# LYRA_DB_PORT=55432
# LYRA_DB_NAME=lyra
# LYRA_DB_USER=lyra
# LYRA_DB_PASSWORD=lyra

# Optional n8n automation plane (ADR-001)
N8N_BASE_URL=
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
