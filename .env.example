GROK_API_KEY=
GROK_BASE_URL=
LYRA_MODEL=
LINEAR_API_KEY=
SUPABASE_ACCESS_TOKEN=
VERCEL_TOKEN=

# Notion (human dashboard — FR-N1/N2)
# Accept either name; Lyra reads NOTION_TOKEN, then NOTION_API_TOKEN, then NOTION_API_KEY.
NOTION_TOKEN=
# Tasks board (Projects DB) — status updates only; never write digests here.
LYRA_NOTION_TASKS_DATABASE_ID=c1c0f9f9-7567-8353-b5c4-81ba90e50c9a
LYRA_NOTION_DATABASE_ID=c1c0f9f9-7567-8353-b5c4-81ba90e50c9a
LYRA_NOTION_PAGE_ID=3a90f9f9-7567-80f2-835e-c665e64927e0
LYRA_NOTION_VIEW_ID=a610f9f9-7567-83e4-a862-08b328e8e7f2
LYRA_NOTION_TITLE_PROPERTY=Project name
LYRA_NOTION_STATUS_PROPERTY_TYPE=status
# Digests DB (research / daily / weekly). Create via:
#   venv\Scripts\python scripts/notion_ensure_digests_db.py
LYRA_NOTION_DIGESTS_DATABASE_ID=
LYRA_NOTION_DIGEST_TITLE_PROPERTY=Name
LYRA_NOTION_PARENT_PAGE_ID=

# Optional: override DB defaults (docker-compose maps host 55432 → container 5432)
# LYRA_DB_HOST=127.0.0.1
# LYRA_DB_PORT=55432
# LYRA_DB_NAME=lyra
# LYRA_DB_USER=lyra
# LYRA_DB_PASSWORD=lyra

# Optional n8n automation plane (ADR-001)
N8N_BASE_URL=
N8N_WEBHOOK_BASE_URL=
N8N_WEBHOOK_SECRET=
